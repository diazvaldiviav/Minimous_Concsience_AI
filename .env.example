# Environment Configuration for Consciousness Pipeline
# ===================================================
# Copy this file to .env and configure your settings

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Phase 7 Configuration
DEFAULT_FINAL_MODEL=gpt-4o-mini

# Debug and Monitoring
ENABLE_MODEL_REGISTRY=true
DEBUG_DIR=./debug

# API Configuration  
API_PORT=8000
API_HOST=0.0.0.0
API_DEBUG=false

# Logging
LOG_LEVEL=INFO

# Optional: Custom model costs (USD per 1K tokens)
# GPT_4O_MINI_INPUT_COST=0.00015
# GPT_4O_MINI_OUTPUT_COST=0.0006
# GPT_4O_INPUT_COST=0.005
# GPT_4O_OUTPUT_COST=0.015