# SC Memory System Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# Core Application Settings
# =============================================================================
APP_NAME=SC Memory System
APP_VERSION=0.1.0
APP_DESCRIPTION=Revolutionary memory consolidation system for LLMs
DEBUG=false
LOG_LEVEL=info

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_PREFIX=/api/v1

# MEP (Memory Exchange Protocol) Settings
MEP_API_PREFIX=/mep/v1
MEP_MAX_PROPOSAL_SIZE=10485760  # 10MB in bytes
MEP_QUEUE_MAX_SIZE=1000
MEP_PROCESS_TIMEOUT=300  # 5 minutes

# Authentication
API_SECRET_KEY=your-super-secret-key-here-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
BEARER_TOKEN=your-bearer-token-here

# =============================================================================
# Model Configuration
# =============================================================================
# Base Model Settings (TinyLlama-1.1B)
BASE_MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0
BASE_MODEL_CACHE_DIR=./models/cache
BASE_MODEL_DEVICE=auto  # Options: auto, cpu, cuda, cuda:0, cuda:1, etc.
BASE_MODEL_MAX_LENGTH=2048
BASE_MODEL_TORCH_DTYPE=auto  # Options: auto, float16, float32, bfloat16

# Model Loading Optimization
MODEL_LOW_CPU_MEM_USAGE=true
MODEL_TRUST_REMOTE_CODE=false
MODEL_USE_SAFETENSORS=true

# =============================================================================
# Embeddings Configuration
# =============================================================================
# Sentence Transformers Model
EMBEDDINGS_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDINGS_CACHE_DIR=./models/embeddings_cache
EMBEDDINGS_DEVICE=auto
EMBEDDINGS_BATCH_SIZE=32
EMBEDDINGS_MAX_SEQ_LENGTH=384
EMBEDDINGS_NORMALIZE_EMBEDDINGS=true

# =============================================================================
# Vector Store Configuration (FAISS)
# =============================================================================
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_DIMENSION=384  # Must match embeddings model dimension
VECTOR_STORE_INDEX_TYPE=IndexFlatL2  # Options: IndexFlatL2, IndexIVFFlat, IndexHNSWFlat
VECTOR_STORE_DATA_DIR=./data/vector_store
VECTOR_STORE_INDEX_PATH=./data/vector_store/faiss.index
VECTOR_STORE_METADATA_PATH=./data/vector_store/metadata.json

# FAISS-specific settings
FAISS_INDEX_FACTORY=Flat
FAISS_METRIC_TYPE=METRIC_L2  # Options: METRIC_L2, METRIC_INNER_PRODUCT
FAISS_NPROBE=8  # For IVF indexes
FAISS_M=16  # For HNSW indexes
FAISS_EFCONSTRUCTION=200  # For HNSW indexes

# =============================================================================
# Storage and Persistence
# =============================================================================
DATA_ROOT_DIR=./data
MODELS_ROOT_DIR=./models
LOGS_DIR=./logs

# Database settings (for future use)
DATABASE_URL=sqlite:///./data/sc_memory.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# File storage settings
MAX_FILE_SIZE=50485760  # 50MB
ALLOWED_FILE_TYPES=json,txt,md

# =============================================================================
# Performance and Resource Management
# =============================================================================
# Memory Management
MAX_MEMORY_USAGE_GB=8
MEMORY_CLEANUP_INTERVAL=300  # 5 minutes
GARBAGE_COLLECTION_THRESHOLD=0.8

# Concurrency Settings
MAX_CONCURRENT_REQUESTS=100
MAX_CONCURRENT_MODEL_OPERATIONS=4
ASYNC_POOL_SIZE=10

# Caching
ENABLE_MODEL_CACHING=true
CACHE_TTL_SECONDS=3600  # 1 hour
CACHE_MAX_SIZE_MB=2048  # 2GB

# =============================================================================
# Monitoring and Observability
# =============================================================================
# Logging Configuration
LOG_FORMAT=json  # Options: json, text
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_CALLER=true
LOG_MAX_FILE_SIZE_MB=100
LOG_MAX_FILES=10

# Metrics and Telemetry
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health Check Settings
HEALTH_CHECK_INTERVAL=30  # seconds
HEALTH_CHECK_TIMEOUT=5  # seconds

# =============================================================================
# Development and Testing
# =============================================================================
# Development Mode Settings
DEV_MODE=false
DEV_AUTO_RELOAD=false
DEV_CORS_ENABLED=true
DEV_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Testing Configuration
TEST_DATABASE_URL=sqlite:///:memory:
TEST_MODEL_CACHE_DISABLED=true
TEST_VECTOR_STORE_IN_MEMORY=true
TEST_PARALLEL_WORKERS=auto

# =============================================================================
# Security Configuration
# =============================================================================
# CORS Settings
CORS_ALLOW_ORIGINS=["https://yourdomain.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE"]
CORS_ALLOW_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Input Validation
MAX_INPUT_LENGTH=10000
MAX_BATCH_SIZE=100
SANITIZE_INPUTS=true

# =============================================================================
# External Services (Future Use)
# =============================================================================
# OpenAI API (for comparisons and testing)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORG_ID=your-org-id-here

# Anthropic API (for comparisons and testing)  
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Monitoring Services
SENTRY_DSN=your-sentry-dsn-here
DATADOG_API_KEY=your-datadog-api-key-here

# =============================================================================
# Model-Specific Optimizations
# =============================================================================
# TinyLlama Specific
TINYLLAMA_ATTENTION_DROPOUT=0.0
TINYLLAMA_HIDDEN_DROPOUT=0.0
TINYLLAMA_USE_CACHE=true

# Transformers Optimizations
TRANSFORMERS_CACHE=./models/transformers_cache
TRANSFORMERS_OFFLINE=false
TRANSFORMERS_VERBOSITY=warning

# PyTorch Optimizations
TORCH_HOME=./models/torch_cache
TORCH_CUDA_ARCH_LIST=7.0,7.5,8.0,8.6
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4